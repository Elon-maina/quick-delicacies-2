PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=food_menu

# Gmail account that sends OTP and order emails. EMAIL_PASS must be a Google "App password"
# (Google Account > Security > App passwords), never your normal Gmail password.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_google_app_password

# Session signing key: a random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Optional: comma-separated origins allowed to call the API when the frontend is NOT
# opened through this server (e.g. http://127.0.0.1:5500 for VS Code Live Server)
CORS_ORIGINS=
